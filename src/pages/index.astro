  <!-- JSON-LD for landing page -->
  <script slot="head" type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "AI Workshop — Free AI Course: Build with Claude Code",
    "description": "A free, beginner-friendly course that teaches you to build and deploy web projects using Claude Code. No coding experience required.",
    "provider": {
      "@type": "Organization",
      "name": "AI Workshop",
      "url": "https://howtoaicode.com/"
    },
    "isAccessibleForFree": true,
    "educationalLevel": "Beginner",
    "inLanguage": "en",
    "coursePrerequisites": "No coding experience required",
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "Online",
      "courseWorkload": "PT3H"
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "category": "Free"
    }
  }
  </script>

  <style slot="head">
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
    }

    body {
      font-family: 'Nunito', system-ui, -apple-system, sans-serif;
      background: oklch(0.99 0.008 78);
      color: oklch(0.16 0.01 260);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
      text-align: center;
      overflow-x: hidden;
    }

    /* Warm background blobs */
    .blob {
      position: fixed;
      border-radius: 50%;
      filter: blur(70px);
      pointer-events: none;
      z-index: 0;
    }

    .blob-1 {
      width: 480px;
      height: 480px;
      background: oklch(0.80 0.14 68);
      opacity: 0.15;
      top: -140px;
      right: -100px;
    }

    .blob-2 {
      width: 360px;
      height: 360px;
      background: oklch(0.76 0.16 48);
      opacity: 0.13;
      bottom: -100px;
      left: -80px;
    }

    .blob-3 {
      width: 220px;
      height: 220px;
      background: oklch(0.83 0.12 85);
      opacity: 0.10;
      top: 38%;
      left: 8%;
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 560px;
      animation: arrive 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes arrive {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: oklch(0.50 0.16 52);
      background: oklch(0.97 0.04 75);
      border: 1.5px solid oklch(0.88 0.09 72);
      border-radius: 100px;
      padding: 0.35rem 0.9rem;
      margin-bottom: 1.75rem;
      letter-spacing: 0.01em;
    }

    h1 {
      font-family: 'Nunito', sans-serif;
      font-size: clamp(2.4rem, 8vw, 3.6rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.25rem;
      letter-spacing: -0.025em;
      color: oklch(0.14 0.01 260);
    }

    .subtitle {
      font-size: 1.1rem;
      color: oklch(0.48 0.008 260);
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }

    .cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2.5rem;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: 'Nunito', sans-serif;
      color: oklch(0.99 0 0);
      background: oklch(0.66 0.19 52);
      border: none;
      border-radius: 100px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 4px 24px oklch(0.66 0.19 52 / 0.36);
    }

    .cta:hover {
      background: oklch(0.58 0.19 52);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px oklch(0.66 0.19 52 / 0.42);
    }

    .cta:active {
      transform: translateY(0);
      box-shadow: 0 2px 12px oklch(0.66 0.19 52 / 0.30);
    }

    .cta:focus-visible {
      outline: 3px solid oklch(0.66 0.19 52);
      outline-offset: 3px;
    }

    .cta-arrow {
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .cta:hover .cta-arrow {
      transform: translateX(3px);
    }

    .proof {
      margin-top: 1.75rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: oklch(0.58 0.01 260);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }

    @media (max-width: 480px) {
      body {
        padding: 1.5rem;
      }

      .subtitle {
        font-size: 1rem;
      }

      .cta {
        padding: 0.875rem 2rem;
        font-size: 1rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .container {
        animation: none;
      }

      .cta,
      .cta-arrow {
        transition: none;
      }
    }
  </style>

  <div class="blob blob-1" aria-hidden="true"></div>
  <div class="blob blob-2" aria-hidden="true"></div>
  <div class="blob blob-3" aria-hidden="true"></div>

  <div class="container">
    <div class="kicker">✦ Free &nbsp;·&nbsp; No experience needed &nbsp;·&nbsp; 3 hours</div>
    <h1>Learn to build your first site with AI</h1>
    <p class="subtitle">
      From complete beginner to deployed project in 3 hours.<br>
      No coding experience required.
    </p>
    <a href="/introduction/" class="cta" id="cta-start">
      Start Free Course
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
    <p class="proof">🎉 Hundreds of beginners have completed this course</p>
  </div>

  <script>
    document.getElementById('cta-start')?.addEventListener('click', function() {
      if (window.posthog) {
        posthog.capture('cta_clicked', { cta: 'start_free_course', page: '/' });
      }
    });
  </script>
</PostHogLayout>
