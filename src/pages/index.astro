---
// Custom landing page with PostHog analytics
import PostHogLayout from '../layouts/PostHogLayout.astro';
---
<PostHogLayout
  title="AI Workshop — Free AI Course: Learn to Build with Claude Code"
  description="A free, beginner-friendly course on building web projects with Claude Code. No coding experience required. Go from zero to a deployed website in 3 hours."
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com">
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">

  <!-- Open Graph -->
  <meta slot="head" property="og:title" content="AI Workshop — Free AI Course: Learn to Build with Claude Code">
  <meta slot="head" property="og:description" content="A free, beginner-friendly course on building web projects with Claude Code. No coding experience required. Go from zero to a deployed website in 3 hours.">
  <meta slot="head" property="og:type" content="website">
  <meta slot="head" property="og:url" content="https://howtoaicode.com/">
  <meta slot="head" property="og:site_name" content="AI Workshop — Free AI Course">
  <meta slot="head" property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta slot="head" name="twitter:card" content="summary_large_image">
  <meta slot="head" name="twitter:title" content="AI Workshop — Free AI Course: Learn to Build with Claude Code">
  <meta slot="head" name="twitter:description" content="A free, beginner-friendly course. No coding experience required. Go from zero to a deployed website in 3 hours.">

  <!-- Canonical -->
  <link slot="head" rel="canonical" href="https://howtoaicode.com/">

